# Copy this file to .env and put your real key there.
# .env is in .gitignore, so it never reaches GitHub.

# --- Option A: OpenAI directly -------------------------------------------
OPENAI_API_KEY=sk-...
# Leave OPENAI_BASE_URL empty or delete the line.
OPENAI_BASE_URL=

# --- Option B: Azure OpenAI (v1 API) --------------------------------------
# OPENAI_API_KEY=<your Azure OpenAI key, from the resource's "Keys and Endpoint">
# OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# On Azure the MODEL_* values below must be your DEPLOYMENT names.

# Model per task (lesson 2.1). Run `python -m scripts.list_models`
# to see which models your key can use, then adjust these.
MODEL_FAST=gpt-4o-mini
MODEL_SMART=gpt-4o-mini
# Step 2 needs a REASONING model (lesson 2.6), e.g. gpt-5-mini or o4-mini.
# On Azure: your deployment NAME, which may differ from the model it runs.
MODEL_REASONING=gpt-5-mini

# How hard the reasoning model thinks: low | medium | high.
# Leave EMPTY if MODEL_REASONING is not a reasoning model.
REASONING_EFFORT=medium

# Step 3 Batch API (lesson 4.4). On Azure: the NAME of a deployment whose
# type is "Global Batch" (a normal Standard deployment is refused).
# On OpenAI leave it empty: MODEL_FAST is used.
MODEL_BATCH=

# Step 3 scoring randomness. 0 = same lead, same score. Leave EMPTY if
# MODEL_FAST is a reasoning model.
SCORING_TEMPERATURE=0

# Web search through Tavily (step 1b). Free key: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Step 1 analysis randomness (lower = more repeatable). Leave EMPTY if
# MODEL_SMART is a reasoning model: they reject the temperature parameter.
ANALYSIS_TEMPERATURE=0.2

# Retry policy for core/client.py (lesson 5.1)
MAX_RETRIES=4
