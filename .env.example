# Copy this file to .env and put your real key there.
# .env is in .gitignore, so it never reaches GitHub.
OPENAI_API_KEY=sk-...

# Model per task (lesson 2.1). Run `python scripts/list_models.py`
# to see which models your key can use, then adjust these.
MODEL_FAST=gpt-4o-mini
MODEL_SMART=gpt-4o-mini
MODEL_REASONING=gpt-4o-mini

# Retry policy for core/client.py (lesson 5.1)
MAX_RETRIES=4
